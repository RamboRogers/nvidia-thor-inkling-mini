diff --git a/models/inkling2/nvidia/ops/thor_alignment.py b/models/inkling2/nvidia/ops/thor_alignment.py
new file mode 100644
index 0000000..1be7f8e
--- /dev/null
+++ b/models/inkling2/nvidia/ops/thor_alignment.py
@@ -0,0 +1,125 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Stable Humming route alignment without native CUDA extensions or CPU reads."""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _count_routes(Ids, Ranks, Counts, Rows, Experts,
+                  N: tl.constexpr, E: tl.constexpr, BLOCK: tl.constexpr,
+                  CAPACITY: tl.constexpr, CHUNK: tl.constexpr,
+                  CHUNKS: tl.constexpr, INIT: tl.constexpr):
+    expert = tl.program_id(0)
+    chunk = tl.program_id(1)
+    row = chunk * CHUNK + tl.arange(0, CHUNK)
+    ids = tl.load(Ids + row, row < N, other=-1)
+    matches = (row < N) & (ids == expert)
+    ranks = tl.cumsum(matches.to(tl.int32)) - 1
+    tl.store(Ranks + row, ranks, matches)
+    tl.store(Counts + chunk * E + expert, tl.sum(matches.to(tl.int32)))
+    # Disjoint initialization; the next launch scatters real routes over it.
+    init = (chunk * E + expert) * INIT + tl.arange(0, INIT)
+    tl.store(Rows + init, N, init < CAPACITY)
+    tl.store(Experts + init, -1, init < tl.cdiv(CAPACITY, BLOCK))
+
+
+@triton.jit
+def _finish_decode(Ids, Ranks, Counts, Rows, Experts, Total,
+                   N: tl.constexpr, E: tl.constexpr, BLOCK: tl.constexpr,
+                   EP: tl.constexpr, RP: tl.constexpr):
+    expert = tl.arange(0, EP)
+    counts = tl.load(Counts + expert, expert < E, other=0)
+    padded = tl.cdiv(counts, BLOCK) * BLOCK
+    starts = tl.cumsum(padded) - padded
+    tl.store(Total, tl.sum(padded))
+    row = tl.arange(0, RP)
+    ids = tl.load(Ids + row, row < N, other=-1)
+    valid = (row < N) & (ids >= 0) & (ids < E)
+    rank = tl.load(Ranks + row, valid, other=0)
+    start = tl.gather(starts, tl.minimum(tl.maximum(ids, 0), E - 1).to(tl.int32), axis=0)
+    dest = start + rank
+    tl.store(Rows + dest, row, valid)
+    tl.store(Experts + dest // BLOCK, ids, valid & (rank % BLOCK == 0))
+
+
+@triton.jit
+def _prefix_chunks(Counts, Offsets, Total,
+                   E: tl.constexpr, CHUNKS: tl.constexpr,
+                   EP: tl.constexpr, CP: tl.constexpr, BLOCK: tl.constexpr):
+    expert = tl.arange(0, EP)
+    chunk = tl.arange(0, CP)
+    counts = tl.load(Counts + chunk[:, None] * E + expert[None, :],
+                     (chunk[:, None] < CHUNKS) & (expert[None, :] < E), other=0)
+    cumulative = tl.cumsum(counts, axis=0)
+    totals = tl.sum(counts, axis=0)
+    padded = tl.cdiv(totals, BLOCK) * BLOCK
+    starts = tl.cumsum(padded) - padded
+    offsets = starts[None, :] + cumulative - counts
+    tl.store(Offsets + chunk[:, None] * E + expert[None, :], offsets,
+             (chunk[:, None] < CHUNKS) & (expert[None, :] < E))
+    tl.store(Total, tl.sum(padded))
+
+
+@triton.jit
+def _scatter_routes(Ids, Ranks, Offsets, Rows, Experts,
+                    N: tl.constexpr, E: tl.constexpr,
+                    BLOCK: tl.constexpr, CHUNK: tl.constexpr):
+    chunk = tl.program_id(0)
+    row = chunk * CHUNK + tl.arange(0, CHUNK)
+    ids = tl.load(Ids + row, row < N, other=-1)
+    valid = (row < N) & (ids >= 0) & (ids < E)
+    rank = tl.load(Ranks + row, valid, other=0)
+    start = tl.load(Offsets + chunk * E + ids, valid, other=0)
+    dest = start + rank
+    tl.store(Rows + dest, row, valid)
+    # Chunk offsets include previous chunks, so a block may start mid-chunk.
+    tl.store(Experts + dest // BLOCK, ids, valid & (dest % BLOCK == 0))
+
+
+def moe_align_block_size(topk_ids, block_size, num_experts,
+                         ignore_invalid_experts=False):
+    """Match the portable Thor implementation, including padding and row order."""
+    if not ignore_invalid_experts or block_size <= 0 or num_experts <= 0:
+        raise ValueError("Thor alignment requires positive sizes and ignore_invalid_experts=True")
+    if not topk_ids.is_cuda:
+        raise ValueError("Triton alignment requires CUDA route indices")
+    flat = topk_ids.reshape(-1)
+    count = flat.numel()
+    capacity = count + num_experts * (block_size - 1)
+    if count < num_experts:
+        capacity = min(count * block_size, capacity)
+    rows = torch.empty(capacity, dtype=torch.int32, device=flat.device)
+    experts = torch.empty(triton.cdiv(capacity, block_size), dtype=torch.int32, device=flat.device)
+    if not count:
+        return rows, experts, torch.zeros(1, dtype=torch.int32, device=flat.device)
+    total = torch.empty(1, dtype=torch.int32, device=flat.device)
+    chunk_size = 256
+    chunks = triton.cdiv(count, chunk_size)
+    ranks = torch.empty(count, dtype=torch.int32, device=flat.device)
+    counts = torch.empty((chunks, num_experts), dtype=torch.int32, device=flat.device)
+    with torch.cuda.device(flat.device):
+        _count_routes[(num_experts, chunks)](
+            flat, ranks, counts, rows, experts, count, num_experts, block_size,
+            capacity, chunk_size, chunks,
+            triton.next_power_of_2(triton.cdiv(capacity, num_experts * chunks)),
+        )
+        if chunks == 1:
+            _finish_decode[(1,)](
+                flat, ranks, counts, rows, experts, total,
+                count, num_experts, block_size,
+                triton.next_power_of_2(num_experts), triton.next_power_of_2(count),
+            )
+        else:
+            offsets = torch.empty_like(counts)
+            _prefix_chunks[(1,)](
+                counts, offsets, total, num_experts, chunks,
+                triton.next_power_of_2(num_experts), triton.next_power_of_2(chunks),
+                block_size, num_warps=8,
+            )
+            _scatter_routes[(chunks,)](
+                flat, ranks, offsets, rows, experts, count, num_experts,
+                block_size, chunk_size,
+            )
+    return rows, experts, total
diff --git a/models/inkling2/nvidia/ops/thor_bf16x.py b/models/inkling2/nvidia/ops/thor_bf16x.py
new file mode 100644
index 0000000..3d3d3f6
--- /dev/null
+++ b/models/inkling2/nvidia/ops/thor_bf16x.py
@@ -0,0 +1,211 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Jetson AGX Thor (sm_110) exact 12-bit packed BF16 (bf16x) GEMV/GEMM dispatch.
+
+Wraps Andy Shu's MIT-licensed pico `bf16x` exact 12-bit format (`inkling_pico12`)
+and cqingwang's MIT-licensed `inkling_wide` multi-row GEMM, compiled for sm_110a.
+Every packed weight decodes bit-identically to the original BF16 tensor (verified
+at load time). Prefill batches above the row thresholds stay on stock cuBLAS.
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import os
+import sys
+from pathlib import Path
+
+import torch
+
+_STATE: dict[str, object] = {
+    "ready": False,
+    "pico_ops": None,
+    "wide_ops": None,
+    "pico_ext": None,
+    "wide_ext": None,
+    "ws_ready": False,
+    "verified_once": False,
+    "packed_count": 0,
+    "packed_bytes": 0,
+    "seen_paths": set(),
+}
+
+
+def enabled() -> bool:
+    return os.environ.get("INKLING2_THOR_BF16X", "0") == "1"
+
+
+def dense_enabled() -> bool:
+    return enabled() and os.environ.get("INKLING2_THOR_BF16X_DENSE", "0") == "1"
+
+
+def head_enabled() -> bool:
+    return enabled() and os.environ.get("INKLING2_THOR_BF16X_HEAD", "1") != "0"
+
+
+def _note(tag: str) -> None:
+    seen = _STATE["seen_paths"]
+    if tag not in seen:
+        seen.add(tag)
+        print(f"[thor_bf16x] ACTIVE PATH: {tag}", file=sys.stderr, flush=True)
+
+
+def _load_so(mod_name: str, so_path: Path):
+    spec = importlib.util.spec_from_file_location(mod_name, str(so_path))
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"thor_bf16x: cannot load extension {so_path}")
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+def _ensure_init(device: torch.device) -> tuple[object, object]:
+    if not _STATE["ready"]:
+        overlay_root = os.environ.get("INKLING2_THOR_BF16X_SRC", "/opt/thor-opt")
+        if overlay_root not in sys.path:
+            sys.path.insert(0, overlay_root)
+        import inkling_pico12.ops as po
+        import inkling_wide.ops as wo
+
+        prebuilt_dir = Path(
+            os.environ.get("INKLING2_THOR_BF16X_PREBUILT", "/opt/thor-opt/ext")
+        )
+        pico_so = prebuilt_dir / "inkling_pico12_ext.so"
+        wide_so = prebuilt_dir / "inkling_wide_ext.so"
+        arch = os.environ.get("INKLING2_THOR_BF16X_ARCH", "110a")
+        if pico_so.is_file() and wide_so.is_file():
+            pext = _load_so("inkling_pico12_ext", pico_so)
+            wext = _load_so("inkling_wide_ext", wide_so)
+            src_label = f"prebuilt({prebuilt_dir})"
+        else:
+            import inkling_pico12.build as pb
+            import inkling_wide.build as wb
+
+            cache_base = Path(
+                os.environ.get(
+                    "INKLING2_THOR_BF16X_CACHE",
+                    os.path.join(os.path.expanduser("~"), "thor-bf16x-cache"),
+                )
+            )
+            pext = pb.load(cache_dir=str(cache_base / "pico12"), arch=arch, verbose=False)
+            wext = wb.load(cache_dir=str(cache_base / "wide"), arch=arch, verbose=False)
+            src_label = f"jit({cache_base})"
+
+        po.EXT = pext
+        wo.EXT = wext
+        wo.SET.sms = torch.cuda.get_device_properties(device).multi_processor_count
+        wo.SET.min_m = 1
+        wo.SET.scope = "all"
+        wo.IN_SCOPE[0] = True
+        _STATE["pico_ops"] = po
+        _STATE["wide_ops"] = wo
+        _STATE["pico_ext"] = pext
+        _STATE["wide_ext"] = wext
+        _STATE["ready"] = True
+        print(
+            f"[thor_bf16x] Loaded sm_{arch} extensions via {src_label} (sms={wo.SET.sms})",
+            file=sys.stderr,
+            flush=True,
+        )
+
+    if not _STATE["ws_ready"]:
+        wo = _STATE["wide_ops"]
+        wo.WS["ws"] = torch.empty(4 * 1024 * 1024, dtype=torch.float32, device=device)
+        wo.WS["cnt"] = torch.zeros(2048, dtype=torch.int32, device=device)
+        _STATE["ws_ready"] = True
+
+    return _STATE["pico_ops"], _STATE["wide_ops"]
+
+
+def pack_weight(
+    weight: torch.Tensor,
+    label: str,
+    kind: str,
+    *,
+    verify: bool = False,
+) -> tuple[object, object]:
+    """Encode a contiguous 2D CUDA BF16 weight into (pico Pack, wide Wide)."""
+    w = weight.detach().contiguous()
+    if w.data_ptr() % 16 != 0:
+        w = w.clone()
+    po, wo = _ensure_init(w.device)
+    pack = po.encode(w, label)
+    if verify or not _STATE["verified_once"]:
+        wext = _STATE["wide_ext"]
+        decoded = wext.decode(pack.buf, pack.n, pack.k)
+        mismatches = int(
+            (decoded.view(torch.uint16) != w.view(torch.uint16)).sum().item()
+        )
+        if mismatches != 0:
+            raise RuntimeError(
+                f"thor_bf16x: exact decode verification FAILED on {label}: {mismatches} mismatches"
+            )
+        _STATE["verified_once"] = True
+        ratio = pack.buf.numel() * pack.buf.element_size() / (
+            w.numel() * w.element_size()
+        )
+        print(
+            f"[thor_bf16x] VERIFIED BIT-EXACT {label} shape={tuple(w.shape)} "
+            f"ratio={ratio:.3f} mt={pack.mt}",
+            file=sys.stderr,
+            flush=True,
+        )
+    wide_entry = wo.make(w, label, kind, pack)
+    _STATE["packed_count"] += 1
+    _STATE["packed_bytes"] += pack.buf.numel() * pack.buf.element_size()
+    if kind == "head" or _STATE["packed_count"] in (1, 48, 49):
+        print(
+            f"[thor_bf16x] packed #{_STATE['packed_count']} {label} kind={kind} "
+            f"fmt={wide_entry.fmt} total={_STATE['packed_bytes']/1e6:.1f} MB",
+            file=sys.stderr,
+            flush=True,
+        )
+    return pack, wide_entry
+
+
+def pico_linear(
+    x: torch.Tensor,
+    pack: object,
+    out_dtype: torch.dtype,
+    out: torch.Tensor | None = None,
+    tag: str = "pico",
+) -> torch.Tensor:
+    _note(tag)
+    po = _STATE["pico_ops"]
+    if out is not None:
+        m = x.numel() // x.shape[-1]
+        if not po.out_ok(out, m, pack, out_dtype, x.device):
+            res = po.linear(x, pack, out_dtype)
+            out.copy_(res)
+            return out
+    return po.linear(x, pack, out_dtype, out=out)
+
+
+def wide_linear(
+    x: torch.Tensor,
+    entry: object,
+    out_dtype: torch.dtype,
+    out: torch.Tensor | None = None,
+    tag: str = "wide",
+) -> torch.Tensor:
+    _note(tag)
+    wo = _STATE["wide_ops"]
+    if out is not None:
+        m = x.numel() // x.shape[-1]
+        if not wo.out_ok(out, m, entry, out_dtype, x.device):
+            res = wo.linear(x, entry, out_dtype)
+            out.copy_(res)
+            return out
+    return wo.linear(x, entry, out_dtype, out=out)
+
+
+def wide_stacked(
+    x_q: torch.Tensor,
+    x_k: torch.Tensor,
+    x_v: torch.Tensor,
+    entry: object,
+    regions: tuple[int, int, int],
+    tag: str = "wide_stacked",
+) -> torch.Tensor:
+    _note(tag)
+    wo = _STATE["wide_ops"]
+    return wo.stacked_project(x_q, x_k, x_v, entry, regions)
diff --git a/models/inkling2/nvidia/ops/thor_vcap.py b/models/inkling2/nvidia/ops/thor_vcap.py
new file mode 100644
index 0000000..205021c
--- /dev/null
+++ b/models/inkling2/nvidia/ops/thor_vcap.py
@@ -0,0 +1,258 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Exact dynamic verify-width cap (vcap) for Inkling-2-Mini DSpark on Jetson Thor.
+
+Uses DSpark's own per-step max draft probability m_j = max(softmax(z_j / T))
+to compute a stopping rule surv_j = prod_{i<=j} m_i inside the captured FULL
+DSpark CUDA graph (zero host sync, static [bs, 8] graphs preserved).
+
+Dead verify rows (local_pos >= L) are:
+  1. Marked in `forward_context.is_padding`, so `Inkling2MoE` / `HummingExperts`
+     (`ignore_invalid_experts=True`) completely skips their MoE experts.
+  2. Masked to `-1` in `gather_draft_sampled`, so `RejectionSampler` stops at
+     live row <= L-1 and draws the exact bonus token from live row L-1 (exact
+     greedy chain and exact sampled distribution).
+
+Env:
+  INKLING2_THOR_VCAP=off | fixed:<L> | conf:<T>[,min=<A>,max=<B>]
+                     | cost:<B1>=<T1>,<B2>=<T2>,...[,min=<A>,max=<B>]
+"""
+
+from __future__ import annotations
+
+import os
+
+try:
+    import torch
+    from vllm.triton_utils import tl, triton
+except ImportError:  # allow offline unit tests of spec parsing without torch/vllm
+    torch = None  # type: ignore[assignment]
+    tl = None  # type: ignore[assignment]
+    triton = None  # type: ignore[assignment]
+
+
+def parse_spec(raw: str | None = None) -> dict[str, object] | None:
+    if raw is None:
+        raw = os.environ.get("INKLING2_THOR_VCAP", "").strip()
+    if not raw or raw.lower() in ("0", "off", "false", "none"):
+        return None
+    parts = [p.strip() for p in raw.split(",") if p.strip()]
+    head = parts[0]
+    min_l, max_l = 2, 8
+    kv_parts = parts[1:]
+    if head.startswith("fixed:"):
+        L = int(head.split(":", 1)[1])
+        if not 1 <= L <= 8:
+            raise ValueError(f"thor_vcap: fixed L={L} must be in 1..8")
+        return {"mode": "fixed", "fixed_l": L, "min_l": L, "max_l": L}
+    if head.startswith("conf:"):
+        t = float(head.split(":", 1)[1])
+        table = [(1024, t)]
+    elif head.startswith("cost:"):
+        first_kv = head.split(":", 1)[1]
+        table = []
+        rem = []
+        for item in [first_kv, *kv_parts]:
+            k, v = item.split("=", 1)
+            k = k.strip()
+            if k == "min":
+                min_l = int(v)
+            elif k == "max":
+                max_l = int(v)
+            else:
+                table.append((int(k), float(v)))
+        kv_parts = rem
+        table.sort(key=lambda x: x[0])
+    else:
+        raise ValueError(f"thor_vcap: invalid INKLING2_THOR_VCAP={raw!r}")
+    for item in kv_parts:
+        k, v = item.split("=", 1)
+        k = k.strip()
+        if k == "min":
+            min_l = int(v)
+        elif k == "max":
+            max_l = int(v)
+    if not (1 <= min_l <= max_l <= 8):
+        raise ValueError(f"thor_vcap: bad min/max ({min_l}, {max_l})")
+    return {"mode": "conf", "table": table, "min_l": min_l, "max_l": max_l}
+
+
+def threshold_for_bs(cfg: dict[str, object], bs: int) -> float:
+    if cfg["mode"] == "fixed":
+        return 0.0
+    table = cfg["table"]
+    for b, t in table:
+        if bs <= b:
+            return t
+    return table[-1][1]
+
+
+if triton is not None:
+
+    @triton.jit
+    def _vcap_step_kernel(
+        Logits,
+        logits_stride,
+        IdxMap,
+        Temp,
+        Surv,
+        LiveLen,
+        thresh,
+        step_idx,
+        V,
+        BLOCK: tl.constexpr,
+    ):
+        """Update surv[r] *= max(softmax(logits[r] / T)) and advance live_len[r]."""
+        r = tl.program_id(0)
+        req_state_idx = tl.load(IdxMap + r).to(tl.int64)
+        temp = tl.load(Temp + req_state_idx).to(tl.float32)
+        inv_t = tl.where(temp > 0.0, 1.0 / temp, 1.0)
+
+        row_ptr = Logits + r.to(tl.int64) * logits_stride
+        m = tl.full((), float("-inf"), tl.float32)
+        s = tl.full((), 0.0, tl.float32)
+        for off in range(0, V, BLOCK):
+            cols = off + tl.arange(0, BLOCK)
+            mask = cols < V
+            vals = tl.load(row_ptr + cols, mask=mask, other=float("-inf")).to(
+                tl.float32
+            )
+            z = vals * inv_t
+            bm = tl.max(z, axis=0)
+            new_m = tl.maximum(m, bm)
+            scale_old = tl.where(m > float("-inf"), tl.exp(m - new_m), 0.0)
+            bs = tl.where(
+                new_m > float("-inf"),
+                tl.sum(
+                    tl.where(mask & (z > float("-inf")), tl.exp(z - new_m), 0.0),
+                    axis=0,
+                ),
+                0.0,
+            )
+            s = s * scale_old + bs
+            m = new_m
+
+        max_prob = tl.where(s > 0.0, 1.0 / s, 0.0)
+        prev_surv = tl.load(Surv + r)
+        new_surv = prev_surv * max_prob
+        tl.store(Surv + r, new_surv)
+        cur_l = tl.load(LiveLen + r)
+        next_l = tl.where(
+            (cur_l == step_idx + 1) & (new_surv >= thresh), step_idx + 2, cur_l
+        )
+        tl.store(LiveLen + r, next_l)
+
+    @triton.jit
+    def _vcap_commit_kernel(
+        LiveLen,
+        IdxMap,
+        OutLiveLens,
+        num_reqs,
+        min_l,
+        max_l,
+        FIXED_L: tl.constexpr,
+    ):
+        r = tl.program_id(0)
+        if r >= num_reqs:
+            return
+        req_state_idx = tl.load(IdxMap + r).to(tl.int64)
+        if FIXED_L > 0:
+            val = FIXED_L
+        else:
+            val = tl.load(LiveLen + r)
+            val = tl.maximum(min_l, tl.minimum(max_l, val))
+        tl.store(OutLiveLens + req_state_idx, val)
+
+    @triton.jit
+    def _vcap_mark_padding_kernel(
+        IsPadding,
+        LogitsIndices,
+        ExpandedIdxMap,
+        ExpandedLocalPos,
+        Positions,
+        PrefillLen,
+        LiveLens,
+        num_logits,
+        BLOCK: tl.constexpr,
+    ):
+        offs = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+        mask = offs < num_logits
+        lp = tl.load(ExpandedLocalPos + offs, mask=mask, other=0)
+        req_idx = tl.load(ExpandedIdxMap + offs, mask=mask, other=0).to(tl.int64)
+        tok_idx = tl.load(LogitsIndices + offs, mask=mask, other=0).to(tl.int64)
+        pos = tl.load(Positions + tok_idx, mask=mask, other=0)
+        plen = tl.load(PrefillLen + req_idx, mask=mask, other=0)
+        live_l = tl.load(LiveLens + req_idx, mask=mask, other=8)
+        is_dead = mask & (lp > 0) & ((pos - lp) >= plen) & (lp >= live_l)
+        tl.store(IsPadding + tok_idx, True, mask=is_dead)
+
+
+def update_step(
+    logits: "torch.Tensor",
+    idx_map_step: "torch.Tensor",
+    temperature: "torch.Tensor",
+    surv: "torch.Tensor",
+    live_len: "torch.Tensor",
+    thresh: float,
+    step_idx: int,
+) -> None:
+    num_reqs, vocab = logits.shape
+    _vcap_step_kernel[(num_reqs,)](
+        logits,
+        logits.stride(0),
+        idx_map_step,
+        temperature,
+        surv,
+        live_len,
+        thresh,
+        step_idx,
+        vocab,
+        BLOCK=2048,
+        num_warps=8,
+    )
+
+
+def commit_live_lens(
+    live_len: "torch.Tensor",
+    idx_map_0: "torch.Tensor",
+    out_live_lens: "torch.Tensor",
+    cfg: dict[str, object],
+) -> None:
+    num_reqs = idx_map_0.shape[0]
+    fixed_l = int(cfg["fixed_l"]) if cfg["mode"] == "fixed" else 0
+    _vcap_commit_kernel[(num_reqs,)](
+        live_len,
+        idx_map_0,
+        out_live_lens,
+        num_reqs,
+        int(cfg["min_l"]),
+        int(cfg["max_l"]),
+        FIXED_L=fixed_l,
+        num_warps=1,
+    )
+
+
+def mark_dead_padding(
+    is_padding: "torch.Tensor",
+    logits_indices: "torch.Tensor",
+    expanded_idx_mapping: "torch.Tensor",
+    expanded_local_pos: "torch.Tensor",
+    positions: "torch.Tensor",
+    prefill_len: "torch.Tensor",
+    live_lens: "torch.Tensor",
+) -> None:
+    n = logits_indices.shape[0]
+    if n <= 0:
+        return
+    BLOCK = 256
+    _vcap_mark_padding_kernel[(triton.cdiv(n, BLOCK),)](
+        is_padding,
+        logits_indices,
+        expanded_idx_mapping,
+        expanded_local_pos,
+        positions,
+        prefill_len,
+        live_lens,
+        n,
+        BLOCK=BLOCK,
+        num_warps=4,
+    )
