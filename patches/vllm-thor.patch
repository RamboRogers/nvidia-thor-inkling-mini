+def _inkling_full_finish_reason(engine_reason, request, message):
+    """Local full-chat convention for one already-parsed, valid named call."""
+    stock = resolve_finish_reason(engine_reason, request, bool(message.tool_calls))
+    if (stock != "stop" or engine_reason != "stop" or request.model != "inkling-mini"
+            or not isinstance(request.tool_choice, ChatCompletionNamedToolChoiceParam)
+            or message.role != "assistant" or len(message.tool_calls) != 1):
+        return stock
+    name = request.tool_choice.function.name
+    call = message.tool_calls[0]
+    if (not name.strip() or call.type != "function" or not call.id.strip()
+            or call.function.name != name):
+        return stock
+    declared = [t.function for t in request.tools or [] if t.type == "function" and t.function.name == name]
+    if len(declared) != 1:
+        return stock
+
+    # Only the audited flat object-schema subset. Don't introduce schema URL
+    # retrieval, arbitrary regex evaluation or recursive validation into serving.
+    schema = declared[0].parameters
+    if not isinstance(schema, dict) or schema.get("type") != "object" or schema.keys() - {
+        "type", "title", "description", "properties", "required", "additionalProperties"
+    } or not isinstance(schema.get("additionalProperties", True), bool):
+        return stock
+    props = schema.get("properties", {})
+    if not isinstance(props, dict) or len(props) > 128 or any(
+        not isinstance(prop, dict) or prop.keys() - {"type", "title", "description"}
+        or prop.get("type") not in ("string", "integer", "number", "boolean", "null")
+        for prop in props.values()
+    ):
+        return stock
+    args = call.function.arguments
+    if len(args) > 65536:
+        return stock
+
+    import json
+    from decimal import Decimal, InvalidOperation
+    from jsonschema import Draft202012Validator, SchemaError
+
+    def reject_constant(_):
+        raise ValueError("non-JSON constant")
+
+    def unique(pairs):
+        obj = dict(pairs)
+        if len(pairs) != len(obj):
+            raise ValueError("duplicate key")
+        return obj
+
+    try:
+        parsed = json.loads(args, parse_constant=reject_constant, object_pairs_hook=unique,
+                            parse_float=Decimal)
+        Draft202012Validator.check_schema(schema)
+        if isinstance(parsed, dict) and Draft202012Validator(schema).is_valid(parsed):
+            return "tool_calls"
+    except (ValueError, RecursionError, InvalidOperation, SchemaError):
+        pass
+    return stock
+
